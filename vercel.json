{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/ebay/auth", "destination": "/api/auth" },
    { "source": "/api/ebay/verify-batch", "destination": "/api/verify-batch" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
